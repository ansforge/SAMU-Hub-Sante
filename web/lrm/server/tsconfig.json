{
  "compilerOptions": {
    "target": "es2021",
    "module": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "./dist"
  },
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "./dist/**/*"]
}
