<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>

<configuration>
    <springProperty scope="context" name="appVersion" source="app.version"/>
    <springProperty scope="context" name="appModelVersion" source="app.model-version"/>
    <springProperty scope="context" name="vhost" source="spring.rabbitmq.virtual-host"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <globalCustomFields>{"vhost":"${vhost}","version":"${appVersion}","modelVersion":"${appModelVersion}"}</globalCustomFields>
            <fieldNames>
                <timestamp>timestamp</timestamp>
            </fieldNames>
            <includeKeyValueKeyName>distributionId</includeKeyValueKeyName>
            <includeKeyValueKeyName>senderId</includeKeyValueKeyName>
            <includeKeyValueKeyName>recipientId</includeKeyValueKeyName>
            <includeKeyValueKeyName>messageType</includeKeyValueKeyName>
        </encoder>
    </appender>

    <!-- We log at ERROR level only except for our own loggers -->
    <root level="ERROR">
        <appender-ref ref="STDOUT" />
    </root>
    <logger name="com.hubsante.hub" level="INFO" additivity="false">
        <appender-ref ref="STDOUT" />
    </logger>
</configuration>