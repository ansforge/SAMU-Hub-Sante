{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["on monday"],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "14 days",
  "automerge": false,
  "registryAliases": {
    "dhi.io": "dhi.io"
  },
  "hostRules": [
    {
      "matchHost": "dhi.io",
      "hostType": "docker",
      "username": "{{ secrets.DHI_USERNAME }}",
      "password": "{{ secrets.DHI_PASSWORD }}"
    },
    {
      "matchHost": "maven.pkg.github.com",
      "hostType": "maven",
      "username": "x-access-token",
      "token": "{{ secrets.GITHUB_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Desactivation de renovate pour le LRM Client, le chatbot, demo-app-tempo & les exemples de clients RabbitMQ Java",
      "matchFileNames": [
        "web/lrm/client/**",
        "tools/chatbot/**",
        "tools/demo-app-tempo/**",
        "clients/**"
      ],
      "enabled": false
    },
    {
      "description": "Mises à jour des GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions updates",
      "separateMajorMinor": false
    },
    {
      "description": "Mises à jour des dépendances - Dispatcher",
      "matchFileNames": ["hub/**"],
      "groupName": "dispatcher updates"
    },
    {
      "description": "Mises à jour des dépendances - Web",
      "matchFileNames": ["web/**"],
      "groupName": "web updates"
    },
    {
      "description": "Mises à jour des dépendances - Tools",
      "matchFileNames": ["tools/**"],
      "groupName": "tools updates"
    }
  ]
}
