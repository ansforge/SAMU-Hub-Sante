{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["* * 24-30 * 3"],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "14 days",
  "automerge": false,
  "registryAliases": {
    "dhi.io": "dhi.io"
  },
  "hostRules": [
    {
      "matchHost": "dhi.io",
      "hostType": "docker",
      "username": "{{ secrets.DHI_USERNAME }}",
      "password": "{{ secrets.DHI_PASSWORD }}"
    }
  ],
  "ignorePaths": [
    "web/lrm/client/**",
    "tools/chatbot/**",
    "tools/demo-app-tempo/**",
    "clients/**"
  ],
  "packageRules": [
    {
      "description": "Mises à jour des GitHub Actions",
      "matchManagers": ["github-actions"],
      "schedule": ["* * 21-30 * 1"],
      "groupName": "github-actions",
      "separateMajorMinor": false
    },
    {
      "description": "Mises à jour des dépendances - Dispatcher",
      "matchFileNames": ["hub/**"],
      "schedule": ["* * 1-10 * 1"],
      "groupName": "dispatcher dependencies"
    },
    {
      "description": "Mises à jour des dépendances - Web & Tools : une PR par répertoire",
      "matchFileNames": ["web/**", "tools/**"],
      "schedule": ["* * 21-30 * 1"],
      "groupName": "dependencies",
      "additionalBranchPrefix": "{{packageFileDir}}-",
      "commitMessageSuffix": "({{packageFileDir}})"
    },
    {
      "description": "Mises à jour des dépendances - tools/specs : client et server regroupés",
      "matchFileNames": ["tools/specs/**"],
      "additionalBranchPrefix": "tools/specs-",
      "commitMessageSuffix": "(tools/specs)"
    },
    {
      "description": "Mises à jour des dépendances - web/lrm : client et server regroupés",
      "matchFileNames": ["web/lrm/**"],
      "additionalBranchPrefix": "web/lrm-",
      "commitMessageSuffix": "(web/lrm)"
    }
  ],
  "vulnerabilityAlerts": {
    "groupName": "security updates"
  }
}
