{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["* * 24-30 * 3"],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "14 days",
  "automerge": false,
  "registryAliases": {
    "dhi.io": "dhi.io"
  },
  "hostRules": [
    {
      "matchHost": "dhi.io",
      "hostType": "docker",
      "username": "{{ secrets.DHI_USERNAME }}",
      "password": "{{ secrets.DHI_PASSWORD }}"
    }
  ],
  "ignorePaths": [
    "web/lrm/client/**",
    "tools/chatbot/**",
    "tools/demo-app-tempo/**",
    "clients/**"
  ],
  "packageRules": [
    {
      "description": "Mises à jour des GitHub Actions",
      "matchManagers": ["github-actions"],
      "schedule": ["* * 21-30 * 1"],
      "groupName": "github-actions",
      "separateMajorMinor": false
    },
    {
      "description": "Mises à jour des dépendances - Dispatcher",
      "matchFileNames": ["hub/**"],
      "schedule": ["* * 1-10 * 1"],
      "groupName": "dispatcher dependencies"
    },
    {
      "description": "Mises à jour des dépendances - Web",
      "matchFileNames": ["web/**"],
      "schedule": ["* * 21-30 * 1"],
      "groupName": "web dependencies"
    },
    {
      "description": "Mises à jour des dépendances - Tools",
      "matchFileNames": ["tools/**"],
      "schedule": ["* * 21-30 * 1"],
      "groupName": "tools dependencies"
    }
  ],
  "vulnerabilityAlerts": {
    "groupName": "security updates"
  }
}
